# ThunderHub configuration template.
# Normally generated by ./scripts/initthub; to write it by hand, copy to
# thubConfig.yaml and set a strong masterPassword before starting.
# .lnd is not mounted in the ThunderHub container: the admin macaroon and
# LND's tls.cert are embedded here base64-encoded, e.g.
#   base64 -w0 .lnd/data/chain/bitcoin/mainnet/admin.macaroon
#   base64 -w0 .lnd/tls.cert
# If LND regenerates tls.cert, re-embed them with ./scripts/refreshcreds.
masterPassword: 'CHANGE_ME_strong_password'
accounts:
  - name: 'NimbleNode'
    serverUrl: 'lit:10009'
    macaroon: 'BASE64_ADMIN_MACAROON'
    certificate: 'BASE64_TLS_CERT'
